# Required
ANTHROPIC_API_KEY=sk-ant-...

# JWT secret (change this in production)
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# PostgreSQL (auto-configured by docker-compose)
DATABASE_URL=postgresql+asyncpg://recall:recall@postgres:5432/recall
SYNC_DATABASE_URL=postgresql://recall:recall@postgres:5432/recall

# Redis (auto-configured by docker-compose)
REDIS_URL=redis://redis:6379

# Optional: Supabase (if using Supabase Auth instead of JWT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
